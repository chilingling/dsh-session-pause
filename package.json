{
  "name": "dsh-session-pause",
  "description": "Host-wide and per-session pause of model activity, including subagents and goals, with Web pause buttons and status surfaces, for DeepSeek Harness",
  "version": "0.4.0",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "cordis",
    "cordis-plugin",
    "pause",
    "resume",
    "session",
    "subagent",
    "goal",
    "agent"
  ],
  "author": "chilingling",
  "homepage": "https://github.com/chilingling/dsh-session-pause#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chilingling/dsh-session-pause.git"
  },
  "bugs": {
    "url": "https://github.com/chilingling/dsh-session-pause/issues"
  },
  "type": "module",
  "main": "lib/host/index.js",
  "types": "lib/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/host/index.d.ts",
      "default": "./lib/host/index.js"
    },
    "./types": {
      "types": "./lib/host/types.d.ts",
      "default": "./lib/host/types.js"
    },
    "./remote": {
      "types": "./lib/host/remote.d.ts",
      "default": "./lib/host/remote.js"
    },
    "./typert": {
      "types": "./lib/host/typert.d.ts",
      "default": "./lib/host/typert.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "README.md",
    "lib/host/**/*.js",
    "lib/host/**/*.d.ts",
    "lib/client.js",
    "lib/client.js.map"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.host.json && tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepare": "pnpm run build"
  },
  "license": "MIT",
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.6-alpha.1",
    "@deepseek-ai/dsh-agent": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-commands": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-llm": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-session": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.2-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.6-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-commands": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.1",
    "@deepseek-ai/cordis-plugin-include": "1.0.11-alpha.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.7-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-agent-loop": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-api-gateway": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-store": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-commands": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-llm-retry": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session-projection": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-alpha.2",
    "@deepseek-ai/schemastery": "3.18.6-alpha.1",
    "@types/node": "^22.20.1",
    "@types/react": "~18.3.1",
    "lightningcss": "^1.33.0",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
